{
  "manifest_version": 3,
  "name": "Parity — Design Overlay & Diff",
  "short_name": "Parity",
  "version": "1.0.0",
  "description": "Overlay Figma JPEG exports per breakpoint and auto-detect offset or mis-sized elements, with an agent-ready JSON report.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Parity (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "debugger",
    "downloads",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Toggle the Parity panel"
    },
    "analyze": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Analyze the active breakpoint against the design"
    }
  },
  "minimum_chrome_version": "121"
}
