{
  "manifest_version": 3,
  "name": "Parity — calibrate a page against its design",
  "short_name": "Parity",
  "version": "3.0.0",
  "description": "Overlay the design JPEG, drag the real page elements into place, and export what you changed as concise CSS / Tailwind notes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Parity (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "debugger",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle the Parity panel"
    },
    "edit": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Toggle edit mode"
    }
  },
  "minimum_chrome_version": "121"
}
